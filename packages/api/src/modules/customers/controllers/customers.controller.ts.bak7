import {
  Body,
  Controller,
  Delete,
  Get,
  Param,
  ParseUUIDPipe,
  Query,
  UseGuards,
} from '@nestjs/common';
import { ZodValidationPipe } from '../../../shared/pipes/zod-validation.pipe';
import { TenantContext } from '../../auth/decorators/tenant-context.decorator';
import type { TenantContext as TenantContextType } from '../../auth/decorators/tenant-context.decorator';
import { Roles } from '../../auth/decorators/roles.decorator';
import { JwtAuthGuard } from '../../auth/guards/jwt-auth.guard';
import { RolesGuard } from '../../auth/guards/roles.guard';
import {
  AnonymizeCustomerSchema,
  type AnonymizeCustomerDto,
  type CustomerExportResponse,
  type CustomerResponse,
  SearchCustomersSchema,
  type SearchCustomersQuery,
} from '../dtos/customer.schema';
import { CustomersService } from '../services/customers.service';

@Controller('api/v1/customers')
@UseGuards(JwtAuthGuard, RolesGuard)
export class CustomersController {
  constructor(private readonly svc: CustomersService) {}

  @Get()
  @Roles('service_advisor', 'manager')
  async search(
    @Query(new ZodValidationPipe(SearchCustomersSchema)) query: SearchCustomersQuery,
    @TenantContext() ctx: TenantContextType,
  ): Promise<{ data: CustomerResponse[] }> {
    const data = await this.svc.search(query, ctx);
    return { data };
  }

  @Get(':id')
  @Roles('service_advisor', 'manager')
  async detail(
    @Param('id', new ParseUUIDPipe()) id: string,
    @TenantContext() ctx: TenantContextType,
  ): Promise<CustomerResponse> {
    return this.svc.findById(id, ctx);
  }

  @Get(':id/data-export')
  @Roles('manager')
  async exportData(
    @Param('id', new ParseUUIDPipe()) id: string,
    @TenantContext() ctx: TenantContextType,
  ): Promise<CustomerExportResponse> {
    return this.svc.exportData(id, ctx);
  }

  @Delete(':id')
  @Roles('manager')
  async anonymize(
    @Param('id', new ParseUUIDPipe()) id: string,
    @Body(new ZodValidationPipe(AnonymizeCustomerSchema)) dto: AnonymizeCustomerDto,
    @TenantContext() ctx: TenantContextType,
  ): Promise<CustomerResponse> {
    return this.svc.anonymize(id, dto.reason, ctx);
  }
}
